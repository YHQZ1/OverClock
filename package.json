{
  "name": "overclock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @overclock/server --filter @overclock/web --parallel dev",
    "build": "pnpm --filter @overclock/server --filter @overclock/web build",
    "start": "pnpm --filter @overclock/server start",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --filter @overclock/server test:unit && pnpm --filter @overclock/web test",
    "test:integration": "pnpm --filter @overclock/server test:integration",
    "test:balance": "pnpm --filter @overclock/server test:balance",
    "test:e2e": "pnpm --filter @overclock/e2e test",
    "test:load": "pnpm --filter @overclock/server test:load",
    "test:coverage": "pnpm --filter @overclock/server test:coverage",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  }
}
