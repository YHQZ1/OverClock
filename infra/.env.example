# Copy to server/.env for local development: cp infra/.env.example server/.env
# On Render, set these in the service's Environment settings (render.yaml wires DATABASE_URL).

# Port the server listens on (Render sets this automatically).
PORT=3000

# development | production
NODE_ENV=development

# Matches infra/docker-compose.yml (host port 5433). Leave unset to play without
# a database: results are then kept in memory until the server restarts.
DATABASE_URL=postgres://overclock:overclock@localhost:5433/overclock

# Optional: lets `pnpm test` also run the database tests (wiped on each run).
TEST_DATABASE_URL=postgres://overclock:overclock@localhost:5433/overclock_test

# Passcode for the /admin page (not built yet — admin is deferred).
ADMIN_PASSCODE=change-me

# Origin of the web app when it runs separately (Vite dev server). Unused when
# the server serves the built web app itself.
WEB_ORIGIN=http://localhost:5173
