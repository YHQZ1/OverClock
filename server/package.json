{
  "name": "@overclock/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:balance": "vitest run --project balance",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "typecheck": "tsc -p . --noEmit && tsc -p tests",
    "balance": "tsx src/scripts/balance.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  }
}
